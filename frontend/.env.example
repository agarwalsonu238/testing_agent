# Public URL of the QA agent backend (inlined into the client bundle at build time)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8400
# Only needed once the backend has API_AUTH_TOKEN set (a deployed backend) — must match it
# exactly. Leave empty for local dev. Note this ends up in the client bundle (anyone who loads
# the dashboard can read it from the network tab), same limit as any browser-only secret.
NEXT_PUBLIC_QA_API_KEY=
