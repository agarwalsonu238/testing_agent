{
  "viewports": {
    "desktop": {
      "width": 1440,
      "height": 900
    },
    "mobile": {
      "width": 390,
      "height": 844,
      "is_mobile": true
    }
  },
  "limits": {
    "slow_api_ms": 2000,
    "slow_page_ms": 5000,
    "page_timeout_ms": 30000,
    "max_links_per_page": 25,
    "max_pages": 15
  },
  "noise_filter": [
    "\\[HMR\\]",
    "\\[Fast Refresh\\]",
    "webpack-hmr",
    "turbopack-hmr",
    "_next/webpack-hmr",
    "__nextjs_original-stack-frame",
    "\\.hot-update\\.",
    "Download the React DevTools",
    "/favicon\\.ico",
    "\\[vite\\] (connecting|connected)",
    "'upgrade-insecure-requests' is ignored when delivered in a report-only policy"
  ],
  "api_url_pattern": "*/api/*",
  "risky_endpoints": [
    {
      "url": "*/api/*payment*"
    },
    {
      "url": "*/api/*refund*"
    },
    {
      "url": "*/api/*payout*"
    },
    {
      "url": "*/api/admin/*",
      "method": "POST"
    },
    {
      "url": "*/api/admin/*",
      "method": "PUT"
    },
    {
      "url": "*/api/admin/*",
      "method": "PATCH"
    },
    {
      "url": "*/api/*",
      "method": "DELETE"
    }
  ],
  "mocks": [],
  "mocks_file": null,
  "auth": {
    "mock_storage_state": null,
    "login": null
  }
}
