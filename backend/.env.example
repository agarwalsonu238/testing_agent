APP_NAME="QA Testing Agent API"
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:4000","http://127.0.0.1:4000"]

# --- App under test ---
APP_URL=http://localhost:3000
APP_REPO_PATH=/path/to/app-repo
DESIGNS_DIR=./designs          # exported design PNGs named after the route: pricing.desktop.png, pricing.mobile.png

# --- QA agent files ---
QA_DIR=./qa                    # qa.config.json (pages, limits, noise filter, risky endpoints, mocks), agents/
RUNS_DIR=./.qa-runs            # one folder per run; never committed
RUNS_KEEP=20

# --- Claude Code (headless, on YOUR Claude subscription; no API key) ---
CLAUDE_BIN=claude
CLAUDE_CODE_VERSION=2.1.323    # pinned; re-check headless subscription login after every upgrade
CLAUDE_MODEL=                  # empty = Claude Code's default for your plan
CLAUDE_RUN_TIMEOUT_S=1200
# Optional, from `claude setup-token`, only if your normal login isn't available to the backend. Never commit.
# CLAUDE_CODE_OAUTH_TOKEN=
# Never set ANTHROPIC_API_KEY: Claude Code would bill the API, so the backend refuses to run agents.

# --- MCP servers for agents (pinned) ---
PLAYWRIGHT_MCP_PACKAGE=@playwright/mcp@0.0.85
CHROME_DEVTOOLS_MCP=false      # separate browser outside the risky-endpoint guard; off by default
CHROME_DEVTOOLS_MCP_PACKAGE=chrome-devtools-mcp@1.13.0
FIGMA_MCP_URL=                 # e.g. http://127.0.0.1:3845/mcp (Figma desktop app). Only for the Design reviewer

# --- Browser ---
BROWSER_CHANNEL=               # empty = Playwright Chromium; "chrome" = installed Google Chrome (needed on macOS 12)
BROWSER_HEADLESS=true

# --- Real-backend mode: shared test account only ---
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=

# --- Save as test ---
TEST_WRITER_OPEN_PR=true       # push the new branch and open a PR with `gh` after the test passes once
DIFF_BASE=origin/main

# --- MCP server (app/mcp_server.py): lets Cursor, Antigravity or any other MCP-compatible
# AI coding tool call Quick Scan / Check my change as tools. Must match where the backend
# and dashboard actually run.
MCP_BACKEND_URL=http://127.0.0.1:8400/api/v1
MCP_DASHBOARD_URL=http://127.0.0.1:4000

# --- Deployed mode only (leave all empty for local use) — see the repo README's "Deploying" section ---
# Required once this backend is reachable from anywhere but localhost: every /api/v1 request
# then needs a matching X-API-Key header (or ?key=). Leave empty locally (127.0.0.1 binding is
# the boundary instead). Pick a long random value.
API_AUTH_TOKEN=
# A deployed container has no local checkout to diff — set these to have it clone/refresh one on
# every start (read-only: Save as test still needs a writable local repo, so stays local-only).
APP_REPO_GIT_URL=                # e.g. https://github.com/org/app-repo.git
APP_REPO_GIT_TOKEN=              # PAT with read access, only for a private repo. Never commit.
APP_REPO_GIT_REF=main            # branch/tag Check my change diffs against
